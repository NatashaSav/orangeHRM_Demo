{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["node", "@playwright/test"],
    "noEmit": true
  },
 "include": [
  "tests/**/*.ts",
  "pages/**/*.ts",
  "fixtures/**/*.ts",
  "data/**/*.ts",
 "utils/**/*.ts",
 "types/**/*.ts"
]
}
